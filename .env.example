# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog Configuration (Analytics, Feature Flags, A/B Testing)
# Get these from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# PostHog Server-Side (optional, for API routes and middleware)
# Use the same key or a project API key with higher permissions
POSTHOG_API_KEY=phc_xxxxxxxxxxxxx

# PostHog Query API — used by the marketing "top posts" digest to rank blog
# posts by pageviews (lib/blog/popularity.ts). Optional: if unset, the digest
# falls back to newest-first. The PERSONAL key (phx_…, NOT the phc_ project
# key) is created at PostHog → Settings → Personal API Keys with "Query Read"
# scope. PROJECT_ID is the numeric id in the project settings/URL.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxx
POSTHOG_PROJECT_ID=12345

# Email Service (Resend) — see docs/EMAIL_HANDOFF.md for full setup
# The code self-skips gracefully when RESEND_API_KEY is unset — invites
# and notifications still work in-app, they just don't dispatch email.
# Get the key from https://resend.com/api-keys after verifying your
# sending domain (DNS records: SPF + DKIM + DMARC).
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM="MonkeyTravel <noreply@monkeytravel.app>"
EMAIL_REPLY_TO=hello@monkeytravel.app
# Optional (future): HMAC secret for one-click unsubscribe tokens
EMAIL_UNSUBSCRIBE_SECRET=set-a-random-32-byte-hex-string

# Supabase "Send Email" auth hook secret.
# Generated in Supabase Dashboard → Authentication → Hooks → Send Email
# when you point the hook at /api/auth/send-email. Paste the full value
# (it looks like "v1,whsec_..."). The route fails closed without it.
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxx

# Google Consent Mode v2 (2026-09-16). "advanced" (default): gtag.js loads with
# every storage type denied and sends cookieless pings until the visitor
# accepts, so Google models the rest. "gated": GA4 is not mounted at all before
# acceptance (the 2026-09-02 behaviour).
NEXT_PUBLIC_GA_CONSENT_MODE=advanced

# ---------------------------------------------------------------------------
# Feature gates (inventoried 2026-09-18). Values are the strings true/false,
# compared exactly. Every NEXT_PUBLIC_* value is inlined at build time, so a
# change on Vercel needs a redeploy; the server-only ones apply on the next
# cold start. Everything here defaults OFF unless the comment says otherwise.
# ---------------------------------------------------------------------------

# Add-to-calendar (.ics download + Google sync) in the trip owner menu.
# Spec: docs/specs/calendar-export-smart-notifs.md. Zero running cost.
NEXT_PUBLIC_CALENDAR_EXPORT_ENABLED=false

# Pre-trip email cascade + in-trip digests (app/api/cron/scheduled-notifications).
# When UNSET it inherits NEXT_PUBLIC_CALENDAR_EXPORT_ENABLED - set it explicitly.
NEXT_PUBLIC_TRIP_NOTIFICATIONS_ENABLED=false

# Digest mails to trip participants who left an email on I'm going.
PARTICIPANT_DIGEST_ENABLED=false

# Add-from-email: paste a booking confirmation, Gemini turns it into an
# activity (components/trip/PasteBookingModal.tsx). Per-use model cost only.
NEXT_PUBLIC_EMAIL_PARSE_ENABLED=false

# Trip concierge chat + history on the trip page (components/trip/TripConciergeChat.tsx).
NEXT_PUBLIC_CONCIERGE_ENABLED=false

# Full expense ledger on the trip page (components/trip/ExpenseLedger.tsx).
# Today mode's Who paid? split does not depend on it.
NEXT_PUBLIC_EXPENSE_LEDGER_ENABLED=false

# Per-day polylines + walking-time labels on the trip map (components/TripMap.tsx).
# Straight-line math from lib/map/geo.ts - no routing API, disclaimer rendered.
NEXT_PUBLIC_MAP_ROUTES_ENABLED=false

# Multi-city toggle in the wizard.
NEXT_PUBLIC_MULTI_CITY_ENABLED=false

# Apple sign-in buttons on login/signup. Configure the Apple provider in
# Supabase (Auth > Providers > Apple) BEFORE flipping this.
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Doodle brand art on the marketing pages. Two names on purpose: the server
# reads HERO_DOODLE_ENABLED per cold start, client bundles inline
# NEXT_PUBLIC_HERO_DOODLE_ENABLED at build (components/marketing/doodle.ts).
HERO_DOODLE_ENABLED=false
NEXT_PUBLIC_HERO_DOODLE_ENABLED=false

# Public trips on /explore (lib/explore/flag.ts).
EXPLORE_UGC_ENABLED=false

# Real Google Places photos on activities. Default ON - set false to stop the
# Places calls (lib/images/activity.ts).
PLACES_ACTIVITY_PHOTOS_ENABLED=true

# Affiliate booking panel. Keep off: monetization is out of scope.
NEXT_PUBLIC_BOOKINGS_ENABLED=false

# Wizard auto-save kill switch: auto-save is ON unless this is exactly off
# (lib/trips/autoSaveGate.ts). Leave unset in normal operation.
# NEXT_PUBLIC_AUTO_SAVE_FORCE=off

# Force every Gemini purpose onto one model (lib/ai/model-router.ts), e.g. to
# keep local costs at zero. Leave unset in production.
# GEMINI_MODEL_OVERRIDE=gemini-2.5-flash-lite
